# Copy to .env.local for development. In Coolify, set these on the application.

# PostgreSQL (the Coolify database resource's internal URL in production)
DATABASE_URL=postgres://postgres@localhost/sos_dev

# Public address of the app, used in links
APP_URL=http://localhost:3000
APP_TIME_ZONE=Africa/Johannesburg

# Photos: "local" writes to a folder (a persistent volume on Coolify),
# "s3" uses any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.data/photos
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Push alerts. Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@digitalflyer.co.za

# Shared secret for the scheduled retry of unsent alerts
CRON_SECRET=

# Behind Coolify's Traefik: read the store connection address from the last
# X-Forwarded-For entry. Leave off when nothing sits in front of the app.
TRUST_PROXY=false
PROXY_HOPS=1

# First sign-in only (npm run db:bootstrap). Remove after use.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ORG_NAME=
